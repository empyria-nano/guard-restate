{
	"name": "@empyria/restate",
	"version": "0.1.10",
	"description": "Restate.dev helpers for the Empyria nanoservice framework",
	"license": "MIT",
	"author": "Imre Fazekas <imre.fazekas@icloud.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/empyria-nano/guard-restate.git"
	},
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./lib/*": "./lib/*.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"format": "bun oxfmt --check",
		"format:fix": "bun oxfmt",
		"lint": "bun oxlint",
		"lint:fix": "bun oxlint --fix",
		"test": "bun test --coverage",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@empyria/classification": "0.1.5",
		"@empyria/common": "0.1.8",
		"@restatedev/pubsub": "0.3.2",
		"@restatedev/pubsub-client": "0.3.2",
		"@restatedev/restate-sdk": "1.17.0",
		"@restatedev/restate-sdk-clients": "1.17.0",
		"@restatedev/restate-sdk-core": "1.17.0",
		"croner": "10.0.1"
	},
	"devDependencies": {
		"@restatedev/restate-server": "1.7.9",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=26"
	},
	"packageManager": "bun@1.4.2"
}
