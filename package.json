	"repository": {
		"type": "git",
		"url": "git+https://github.com/imrefazekas/principia-guard-restate.git"
	},
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./lib/*": "./lib/*.js",
