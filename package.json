		"@restatedev/restate-sdk-clients": "1.6.1",
		"@restatedev/restate-sdk-core": "1.6.1",
		"croner": "10.0.1"
	},
	"devDependencies": {
		"@restatedev/restate-server": "1.7.3",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=26"
	},
	"packageManager": "bun@1.4.0"
