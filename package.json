{
	"name": "@empyria/restate",
	"version": "0.4.0",
	"description": "Restate.dev helpers for the Empyria nanoservice framework",
	"license": "MIT",
	"author": "Imre Fazekas <imre.fazekas@icloud.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/empyria-nano/guard-restate.git"
	},
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./agent": "./agent.js",
		"./testing": "./testing.js",
		"./lib/*": "./lib/*.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"format": "bun oxfmt --check",
		"format:fix": "bun oxfmt",
		"lint": "bun oxlint",
		"lint:fix": "bun oxlint --fix",
		"test": "bun test --coverage",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@empyria/classification": "0.1.9",
		"@empyria/common": "0.3.9",
		"@restatedev/pubsub": "0.3.2",
		"@restatedev/pubsub-client": "0.3.2",
		"@restatedev/restate-sdk": "1.17.2",
		"@restatedev/restate-sdk-clients": "1.17.2",
		"@restatedev/restate-sdk-core": "1.17.2",
		"croner": "10.0.1"
	},
	"devDependencies": {
		"@ai-sdk/openai-compatible": "3.0.62",
		"@ai-sdk/provider": "4.0.21",
		"@restatedev/restate-server": "1.7.13",
		"ai": "7.0.127",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0"
	},
	"peerDependencies": {
		"@ai-sdk/openai-compatible": "^3.0.60",
		"@ai-sdk/provider": "^4.0.20",
		"ai": "^7.0.123"
	},
	"peerDependenciesMeta": {
		"@ai-sdk/openai-compatible": {
			"optional": true
		},
		"@ai-sdk/provider": {
			"optional": true
		},
		"ai": {
			"optional": true
		}
	},
	"engines": {
		"bun": ">=1.4.2",
		"node": ">=26"
	},
	"packageManager": "bun@1.4.2"
}
